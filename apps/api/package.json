{
  "name": "api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:watch": "wrangler dev --local --live-reload",
    "build": "rm -rf dist && wrangler deploy --dry-run --outdir dist",
    "preview": "wrangler dev --local --script ./dist/index.js --assets ./../web/dist",
    "deploy": "wrangler deploy --minify",
    "lint": "eslint . --no-cache --format stylish && echo \"✅ Lint passed for api\"",
    "format": "prettier . --write --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-validator": "^0.7.6",
    "@upstash/redis": "^1.36.2",
    "hono": "^4.12.3",
    "hono-pino": "^0.10.3",
    "pino": "^10.3.1",
    "redis-on-workers": "^0.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.0",
    "@types/node": "^25.3.0",
    "wrangler": "^4.69.0"
  }
}
